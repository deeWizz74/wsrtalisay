  "meta": {
    "title": "Talisay Stake — Know Your Specialist",
    "updatedAt": "2026-09-18T16:37:10.829Z",
    "roleLegend": {
      "WSR Specialist": "Leads the ward Welfare & Self-Reliance committee.",
      "Education Specialist": "Helps members pursue education and skills training.",
      "Family Services Specialist": "Connects members with counseling and family support resources.",
      "Health and Nutrition Specialist": "Supports members on health, nutrition, and emergency preparedness.",
      "GAMA Specialist": "GAMA = Guide to Administering Medical Assistance. Helps members access medical assistance guidance.",
      "My Plan Specialist": "Helps Returned Missionaries build their personal My Plan for continued self-reliance.",
      "Business and Employment Specialist": "Assists with job search, resumes, and small business support.",
      "ATPG Specialist": "ATPG = Area Temporal Preparedness Guide. Coordinates emergency and temporal preparedness planning.",
      "High Councilor": "Assigned stake leader supporting wards and stake committees.",
      "Education Chairman": "Helps members pursue education and skills training.",
      "Education Vice-Chairman": "Assists and co-leads with the Education Chairman.",
      "Family Services Chairman": "Connects members with counseling and family support resources.",
      "Family Services Vice-Chairman": "Assists and co-leads with the Family Services Chairman.",
      "Health and Nutrition Chairman": "Supports members on health, nutrition, and emergency preparedness.",
      "Health and Nutrition Vice-Chairman": "Assists and co-leads with the Health and Nutrition Chairman.",
      "GAMA Chairman": "GAMA = Guide to Administering Medical Assistance. Helps members access medical assistance guidance.",
      "GAMA Vice-Chairman": "Assists and co-leads with the GAMA Chairman.",
      "My Plan Chairman": "Helps Returned Missionaries build their personal My Plan for continued self-reliance.",
      "My Plan Vice-Chairman": "Assists and co-leads with the My Plan Chairman.",
      "Business and Employment Chairman": "Assists with job search, resumes, and small business support.",
      "Business and Employment Vice-Chairman": "Assists and co-leads with the Business and Employment Chairman.",
      "ATPG Chairman": "ATPG = Area Temporal Preparedness Guide. Coordinates emergency and temporal preparedness planning.",
      "ATPG Vice-Chairman": "Assists and co-leads with the ATPG Chairman.",
      "Stake Welfare and Self-Reliance Specialist": "Leads the ward Welfare & Self-Reliance committee.",
      "Stake WSR Secretary": "Keeps committee records and supports the Stake WSR Specialist.",
      "Stake Presidency": "Presides over the stake — the President and his two counselors."
    }
